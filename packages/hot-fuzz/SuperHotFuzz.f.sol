        PDPoolMember_0 memory pdPoolMember = _memberDataToPDPoolMember(_disconnectedMembers);
        return Value_0.unwrap(PDPoolMemberMU_0(pdPoolIndex, pdPoolMember).rtb(Time_0.wrap(time)));
