    }

    // Constants & Immutables

    string internal constant _DEFAULT_ERC20_NAME = "Superfluid Pool";
    string internal constant _DEFAULT_ERC20_SYMBOL = "POOL";
    // ERC20 decimals implicitly defaults to 0

