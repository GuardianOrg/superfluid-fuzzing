// Notes: We use these interfaces in natspec documentation below, grep @inheritdoc
// solhint-disable-next-line no-unused-import

using SafeCast for uint256;
using SafeCast for int256;

function toSemanticMoneyUnit(uint128 units) pure returns (Unit_0) {
    // @note safe upcasting from uint128 to uint256
    // and use of safecast library for downcasting from uint256 to int128
    return Unit_0.wrap(uint256(units).toInt256().toInt128());
}

function poolIndexDataToWrappedParticle(ISuperfluidPool_0.PoolIndexData memory data)
    pure
    returns (BasicParticle_0 memory wrappedParticle)
{
    wrappedParticle = BasicParticle_0({
        _settled_at: Time_0.wrap(data.wrappedSettledAt),
        _flow_rate: FlowRate_0.wrap(int128(data.wrappedFlowRate)), // upcast from int96 is safe
        _settled_value: Value_0.wrap(data.wrappedSettledValue)
    });
}

function poolIndexDataToPDPoolIndex(ISuperfluidPool_0.PoolIndexData memory data)
    pure
    returns (PDPoolIndex_0 memory pdPoolIndex)
{
    pdPoolIndex = PDPoolIndex_0({
        total_units: toSemanticMoneyUnit(data.totalUnits),
        _wrapped_particle: poolIndexDataToWrappedParticle(data)
    });
}

/**
 * @title SuperfluidPool
