contract SuperfluidPool is ISuperfluidPool_0, BeaconProxiable {
    using SemanticMoney_0 for BasicParticle_0;

    // Structs
    struct MemberData {
        uint128 ownedUnits;
        uint32 syncedSettledAt;
        int96 syncedFlowRate;
        int256 syncedSettledValue;
        int256 settledValue;
